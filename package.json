{
  "name": "html360-space",
  "private": true,
  "type": "module",
  "scripts": {
    "type-check:api": "tsc -p src/api/tsconfig.json --noEmit",
    "type-check:web": "tsc -p src/web/tsconfig.json --noEmit",
    "type-check": "npm run type-check:api && npm run type-check:web",

    "lint": "biome check .",
    "lint:fix": "biome check --write .",

    "dev:web": "vite dev --config src/web/vite.config.ts",

    "build:api": "vite build --config src/api/vite.config.ts",
    "build:web": "vite build --config src/web/vite.config.ts",
    "build": "npm run type-check && npm run build:api && npm run build:web"
  },
  "dependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/express": "4.17.21",
    "@types/node": "20.12.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.0",
    "express": "4.19.2",
    "mobx": "6.12.3",
    "mobx-react-lite": "4.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.23.1",
    "typescript": "5.4.5",
    "vite": "5.2.11"
  }
}
